# Copy this file to .env and fill in the real password.

# Local dev (npm start): app connects to Postgres on localhost
DATABASE_URL=postgres://postgres:password@localhost:5432/tasks

# docker compose: Postgres container password (compose builds DATABASE_URL
# with host "db" from this)
POSTGRES_PASSWORD=password

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_anon_key